<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <EditText
            android:id="@+id/etNombre"
            style="@style/Campo"
            android:hint="Nombre de la materia"
            android:inputType="textCapSentences" />

        <EditText
            android:id="@+id/etProfesor"
            style="@style/Campo"
            android:layout_marginTop="10dp"
            android:hint="Profesor"
            android:inputType="textPersonName|textCapWords" />

        <EditText
            android:id="@+id/etAula"
            style="@style/Campo"
            android:layout_marginTop="10dp"
            android:hint="Aula" />

        <TextView
            style="@style/Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COLOR" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/selectorColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/bloqueHorario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HORARIO (OPCIONAL)" />

            <EditText
                android:id="@+id/etDia"
                style="@style/Campo"
                android:hint="Día (lunes, martes...)" />

            <EditText
                android:id="@+id/etHoraInicio"
                style="@style/Campo"
                android:layout_marginTop="10dp"
                android:hint="Hora de inicio (07:00)" />

            <EditText
                android:id="@+id/etHoraFin"
                style="@style/Campo"
                android:layout_marginTop="10dp"
                android:hint="Hora de fin (09:00)" />

            <EditText
                android:id="@+id/etHorarioExtra"
                style="@style/Campo"
                android:layout_marginTop="10dp"
                android:hint="Otros días: miercoles 07:00-09:00, viernes 09:00-11:00" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
